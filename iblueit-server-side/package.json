{
  "name": "BlueApiFunctions",
  "version": "1.0.0",
  "description": "",
  "scripts": {
    "start": "func start",
    "test": "jest --coverage"
  },
  "dependencies": {
    "axios": "^0.27.2",
    "bcryptjs": "^2.4.3",
    "moment": "^2.24.0",
    "moment-timezone": "^0.5.28",
    "mongoose": "^5.9.2",
    "nodemailer": "^6.4.6",
    "uuid": "^7.0.3",
    "validate.js": "^0.13.1",
    "validator": "^13.1.1",
    "validatorjs": "^3.18.1",
    "xmlhttprequest": "^1.8.0"
  },
  "devDependencies": {
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>"
    ],
    "testMatch": [
      "**/*.test.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/report-ai/",
      "<rootDir>/coverage/"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/report-ai/"
    ],
    "watchPathIgnorePatterns": [
      "<rootDir>/report-ai/"
    ],
    "collectCoverageFrom": [
      "*/index.js",
      "shared/**/*.js",
      "!**/*.test.js",
      "!**/node_modules/**",
      "!coverage/**",
      "!report-ai/**",
      "!test-utils/**"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": [
      [
        "lcov",
        {
          "projectRoot": ".."
        }
      ],
      "text-summary",
      "text"
    ]
  }
}
